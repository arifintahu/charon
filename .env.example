# Strategy params (TP/SL, position size, filter thresholds, LLM confidence) live
# in strategies/*.json — NOT here. Edit a JSON file, then restart or run
# `node scripts/cmd.js resetstrategies confirm` to apply.

# ─── Telegram (required) ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ID=

# ─── Solana RPC (required) ─────────────────────────────────────────────
# Helius free tier covers dry_run. SOLANA_RPC_URL / SOLANA_WS_URL override
# the auto-built Helius URLs if you'd rather use a different provider.
HELIUS_API_KEY=
SOLANA_RPC_URL=
SOLANA_WS_URL=

# ─── Signal source (required) ──────────────────────────────────────────
# Server mode: poll the Charon signal server (contact maintainer for access).
# If unset, the bot runs in legacy standalone mode (fee-claim WS + graduated
# poll + trending poll) — see GRADUATED_* / TRENDING_* below.
SIGNAL_SERVER_URL=https://api.thecharon.xyz/api
SIGNAL_SERVER_KEY=
SIGNAL_POLL_MS=30000

# ─── Trading mode ──────────────────────────────────────────────────────
# dry_run | confirm | live. confirm/live also need the wallet + Jupiter
# section below.
TRADING_MODE=dry_run

# ─── Wallet + Jupiter (only for confirm/live) ──────────────────────────
SOLANA_PRIVATE_KEY=
JUPITER_API_KEY=
JUPITER_SWAP_BASE_URL=https://api.jup.ag/swap/v2
# Minimum SOL kept in the wallet after any buy.
LIVE_MIN_SOL_RESERVE=0.02

# ─── LLM screening (optional) ──────────────────────────────────────────
# Any OpenAI-compatible endpoint. Set ENABLE_LLM=false to skip globally.
# Per-strategy use_llm: false (e.g. degen) auto-approves filtered candidates.
ENABLE_LLM=true
LLM_BASE_URL=https://api.minimax.io/v1
LLM_API_KEY=
LLM_MODEL=MiniMax-M2.7
LLM_TIMEOUT_MS=60000
LLM_CANDIDATE_PICK_COUNT=10
LLM_CANDIDATE_MAX_AGE_MS=600000

# ─── GMGN enrichment (optional) ────────────────────────────────────────
# Set GMGN_ENABLED=false to skip — falls back to Jupiter data for everything
# GMGN normally provides. Aggressive rate limits; keep delay >= 2500ms.
GMGN_ENABLED=true
GMGN_API_KEY=
GMGN_REQUEST_DELAY_MS=2500
GMGN_MAX_RETRIES=2
GMGN_CACHE_TTL_MS=300000

# ─── Storage ───────────────────────────────────────────────────────────
DB_PATH=./charon.sqlite
# Postgres analytics sink (optional). Empty = no-op. `npm run pg:up` starts
# a local instance via docker-compose. Required for the backtester.
POSTGRES_URL=postgres://charon:charon@localhost:5432/charon
# Identity for cross-machine analytics. Auto-generated UUID if blank.
CHARON_MACHINE_ID=
CHARON_MACHINE_LABEL=

# ─── Polling cadence (tuning) ──────────────────────────────────────────
# Position monitor — TP/SL/trailing checks per open position.
POSITION_CHECK_MS=10000
# Standalone-mode signal pollers (ignored when SIGNAL_SERVER_URL is set).
GRADUATED_POLL_MS=30000
GRADUATED_LOOKBACK_MS=7200000
TRENDING_POLL_MS=60000
TRENDING_LOOKBACK_MS=600000

# ─── Trending feed defaults ────────────────────────────────────────────
# These are global feed-shape settings; per-strategy trending_min_volume_usd
# / trending_min_swaps / trending_max_rug_ratio / trending_max_bundler_rate
# live in strategies/*.json.
TRENDING_ENABLED=true
TRENDING_SOURCE=jupiter
TRENDING_ALLOW_DEGEN=false
TRENDING_INTERVAL=5m
TRENDING_LIMIT=100
TRENDING_ORDER_BY=volume
